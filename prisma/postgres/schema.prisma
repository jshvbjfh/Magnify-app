generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH ──────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  password     String
  role         String   @default("owner")
  businessType String?
  logoUrl      String?
  trackingMode String   @default("simple")
  fifoEnabled  Boolean  @default(false)
  isActive     Boolean  @default(true)
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurants        Restaurant[] @relation("RestaurantOwner")
  managedRestaurants Restaurant[] @relation("RestaurantManager")

  @@map("users")
}

// ─── RESTAURANT / BRANCH ───────────────────────────────────────────────────

model Restaurant {
  id                 String    @id @default(cuid())
  name               String
  ownerId            String
  owner              User      @relation("RestaurantOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  managerId          String?
  manager            User?     @relation("RestaurantManager", fields: [managerId], references: [id], onDelete: SetNull)
  joinCode           String    @unique
  billHeader         String?
  billPrinterIp      String?
  billPrinterPort    Int?
  qrOrderingMode     String    @default("order")
  licenseExpiry      DateTime?
  licenseActive      Boolean   @default(true)
  fifoEnabled        Boolean   @default(true)
  fifoConfiguredAt   DateTime?
  // One stock for the whole restaurant, held by the main station, instead of
  // every station keeping its own. Off by default: it only suits venues whose
  // stations share a physical store, so a customer whose "stations" are
  // separate premises keeps stock per station. Flipping it back restores the
  // per-station behaviour without touching data.
  sharedStock        Boolean   @default(false)
  // Whether this venue runs service shifts. On by default, so every existing
  // restaurant keeps the supervisor-opens-the-day flow. Switched off, the
  // waiter app stops gating on a shift and stops stamping orders with one —
  // those orders fall back to paidAt for reporting, exactly as the nullable
  // shiftId/businessDate columns were always designed to allow. Orders already
  // stamped keep their shift, so history stays intact either way.
  shiftsEnabled      Boolean   @default(true)
  // Print a payment-confirmation slip automatically every time a bill is
  // settled: the same bill the guest already got, plus the tender it was paid
  // with. Some venues hand it over as the receipt; most do not want a second
  // slip per table, so it is off unless a manager asks for it.
  printPaymentConfirmation Boolean @default(false)
  // The taxpayer's TIN, printed on every fiscal receipt.
  //
  // There is deliberately NO "fiscal mode" column beside this. Whether VAT is
  // charged is decided by which BUILD is installed, not by a row anyone can
  // edit — see lib/fiscalMode.ts. A certified system must have no off switch,
  // and a switch sitting in the database is one, whatever it is called.
  //
  // Null means this venue has not been registered with RRA yet. On a fiscal
  // build that is not "VAT off" — it is "not configured", and the till refuses
  // to trade until it is filled in.
  tin                String?
  // Hides financial history before this date from the Transactions page without
  // deleting anything — the entries stay in the database (so stock, purchase
  // records and audits remain intact) and clearing this field restores them.
  historyVisibleFrom DateTime?
  syncRestaurantId   String?   @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  branches       Branch[]
  staff          Staff[]
  categories     Category[]
  accounts       Account[]
  journalEntries JournalEntry[]
  devices        BranchDevice[]
  creditSales    CreditSale[]
  supplierDebts  SupplierDebt[]
  shifts         Shift[]

  @@index([ownerId])
  @@index([managerId])
  @@map("restaurants")
}

// A service session (a "shift"), opened and closed by a supervisor. This is the
// venue-level "we are open now" — NOT a staff wage clock-in (that is
// EmployeeShift). Every order created while a shift is open is stamped with it,
// and the shift's businessDate is the day those sales belong to for reporting —
// so a table opened at 11pm and paid at 1am still counts on the day the shift
// opened, not the calendar day it was settled. Whole-venue: at most one OPEN
// shift per restaurant at a time.
model Shift {
  id              String     @id @default(cuid())
  restaurantId    String
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // The calendar day (restaurant timezone) this shift's sales are attributed to.
  businessDate    DateTime
  status          String     @default("OPEN") // OPEN | CLOSED
  openedAt        DateTime   @default(now())
  openedByName    String?
  openedByStaffId String?
  closedAt        DateTime?
  closedByName    String?
  closedByStaffId String?
  sourceDeviceId  String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  orders RestaurantOrder[]

  @@index([restaurantId, status])
  @@index([restaurantId, businessDate])
  @@map("service_shifts")
}

model Branch {
  id                 String     @id @default(cuid())
  restaurantId       String
  restaurant         Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name               String
  code               String
  type               String     @default("kitchen")
  isMain             Boolean    @default(false)
  isActive           Boolean    @default(true)
  address            String?
  billHeader         String?
  qrMenuHeroImageUrl String?
  // ── RRA fiscal identity ──────────────────────────────────────────────────
  // Issued by RRA when the outlet is registered, and printed on its receipts.
  // Per BRANCH, not per restaurant: a taxpayer with several outlets is issued
  // separate identifiers for each, and a receipt carrying the wrong outlet's
  // SDC is as wrong as one carrying no SDC at all.
  //
  // All nullable, and only read by a fiscal build. A fiscal build refuses to
  // trade until they are set — it never falls back to trading without them.
  rraBranchCode      String?
  sdcId              String?
  mrc                String?
  // Where this outlet reaches the sales-data controller. Stored per branch
  // because RRA issues credentials per outlet — NOT because the controller is
  // on the local network. RRA hosts it, and the spec requires the invoicing
  // system to be online to reach it.
  vsdcUrl            String?
  deviceSerial       String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  tables         RestaurantTable[]
  orders         RestaurantOrder[]
  dishes         Dish[]
  inventoryItems InventoryItem[]
  purchases      InventoryPurchase[]
  dishSales      DishSale[]
  wasteLogs      WasteLog[]
  stockTakes     StockTake[]
  adjustmentLogs InventoryAdjustmentLog[]
  staffBranches  StaffBranch[]
  shifts         EmployeeShift[]
  kitchenTickets KitchenTicket[]
  syncCursors    SyncCursor[]
  syncOutbox     SyncOutbox[]

  @@unique([restaurantId, code])
  @@index([restaurantId])
  @@map("branches")
}

// ─── STAFF ─────────────────────────────────────────────────────────────────

// Waiters and managers live here — separate from the owner User account.
// pin: bcrypt hash, used for PIN-on-device auth (shared terminal).
// password: bcrypt hash, used for username+password auth (personal login).
// A staff member may have one or both auth methods.
model Staff {
  id              String     @id @default(cuid())
  restaurantId    String
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name            String
  role            String     @default("waiter")
  username        String?
  password        String?
  pin             String?
  cancellationPin String?
  hourlyRate      Float?
  isActive        Boolean    @default(true)
  phone           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  branches StaffBranch[]
  orders   RestaurantOrder[]
  shifts   EmployeeShift[]

  @@unique([restaurantId, username])
  @@index([restaurantId])
  @@map("staff")
}

model StaffBranch {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, branchId])
  @@map("staff_branches")
}

model EmployeeShift {
  id             String    @id @default(cuid())
  restaurantId   String
  branchId       String
  branch         Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staffId        String
  staff          Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  clockInAt      DateTime
  clockOutAt     DateTime?
  durationMins   Int?
  calculatedWage Float?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([branchId, staffId, clockInAt])
  @@map("employee_shifts")
}

// ─── TABLES & ORDERS ───────────────────────────────────────────────────────

model RestaurantTable {
  id           String    @id @default(cuid())
  restaurantId String
  branchId     String
  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name         String
  seats        Int       @default(4)
  status       String    @default("available")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  orders RestaurantOrder[]

  // Tables belong to the restaurant, not a single branch — every branch shares
  // the same floor plan. branchId is retained only as origin metadata.
  @@unique([restaurantId, name])
  @@index([restaurantId, branchId])
  @@map("restaurant_tables")
}

model RestaurantOrder {
  id             String           @id @default(cuid())
  restaurantId   String
  branchId       String
  branch         Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tableId        String?
  table          RestaurantTable? @relation(fields: [tableId], references: [id])
  tableName      String?
  orderNumber    String
  status         String           @default("PENDING")
  paymentMethod  String?
  subtotalAmount Float            @default(0)
  vatAmount      Float            @default(0)
  totalAmount    Float            @default(0)
  staffId        String?
  staff          Staff?           @relation(fields: [staffId], references: [id])
  // How many people sat at the table, typed by the waiter when the order is
  // rung up. Optional — the waiter can skip it, and orders from before this
  // existed carry null. Reports must therefore treat null as "unknown", never
  // as zero, and exclude those orders from average-per-cover entirely.
  guestCount     Int?
  createdByName  String?
  // Set when this order was merged into another one. The row is kept, its
  // status moved to MERGED and its items reassigned, so the join is auditable
  // and the order number a guest may already have been quoted still resolves.
  // MERGED is deliberately not in ACTIVE_RESTAURANT_ORDER_STATUSES or the
  // unsettled set: a merged order must not sit on the pending list, block an
  // end-of-shift, or be payable a second time.
  mergedIntoId   String?
  // Which app took the order: 'tablet' (the Android APK) or 'desktop' (the
  // Windows till). Null on everything taken before this existed, and on guest
  // QR orders, which arrive through the web route rather than a waiter app.
  //
  // The tablet cannot print — no spooler, no raw socket, no print plugin — so a
  // ticket for an order it took never reaches the kitchen on its own. The till
  // reads this to decide which pending orders still need pushing to the
  // printers by hand. Treat null as "not from a tablet": for old orders that is
  // correct, and it means enabling the feature never offers to reprint history.
  source         String?
  cancelReason   String?
  notes          String?
  paidAt         DateTime?
  servedAt       DateTime?
  canceledAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  // Who actually closed the bill. Deliberately separate from createdByName: a
  // supervisor may settle any waiter's table, and when they do the sale must
  // still belong to the waiter who took it. Null on every order settled before
  // this existed, and on orders closed by their own waiter, so read it as
  // "nobody other than the waiter", never as "nobody".
  settledByName  String?

  // The supervisor whose PIN approved the cancellation. cancelReason says why;
  // this says who authorised it, which is the half the cancellation report
  // could not show before. Null on cancellations recorded before this existed.
  canceledByName String?

  // A comped bill: the boss's guests eat, nothing is charged, and paymentMethod
  // reads 'No Charge'. The reason is mandatory at the till, so a null here on a
  // No Charge order means the record predates this field.
  noChargeReason String?
  // What the comp was worth at menu prices. The order's own totals are zeroed
  // on a No Charge settlement — that is what keeps revenue, APC and every sales
  // report honest without each having to know about comps — so this is the only
  // surviving record of the value written off, and it is what the No Charge
  // report totals.
  compedAmount   Float?

  // Accounts Receivable: customer name when paid on credit, and when the A/R was collected.
  // The phone is optional — staff often know the guest by name alone — so null
  // means "not taken", never "no phone". It exists so an unpaid tab can actually
  // be chased without hunting through the order history for who owes what.
  arCustomerName  String?
  arCustomerPhone String?
  arCollectedAt   DateTime?

  // Linked to the accounting entry created when this order is paid
  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  // Service session this order belongs to, and the business day (from the
  // shift) its sales are attributed to. Nullable: orders created without an
  // open shift, and legacy/imported orders, fall back to paidAt in reports.
  shiftId      String?
  shift        Shift?    @relation(fields: [shiftId], references: [id])
  businessDate DateTime?

  items     OrderItem[]
  dishSales DishSale[]
  tickets   KitchenTicket[]

  @@unique([restaurantId, orderNumber])
  @@index([branchId, status, createdAt])
  // Restaurant-wide reports (upselling, branch-summary, dish-profitability) all
  // filter on restaurantId + status + the business day, falling back to paidAt
  // when an order carries no shift. The branch index above cannot serve them
  // because those reports deliberately span every station, so without these two
  // Postgres scans every order the restaurant has ever taken.
  @@index([restaurantId, status, businessDate])
  @@index([restaurantId, status, paidAt])
  @@map("restaurant_orders")
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  order           RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dishId          String
  dish            Dish            @relation(fields: [dishId], references: [id])
  // Station snapshot at order-creation time, no FK — attribution hint only.
  // Null on legacy rows; server falls back to the dish's live branchId, then
  // params.branchId. Guards against a dish being reassigned to a different
  // station while an order containing it is still open/unpaid.
  branchId        String?
  dishVariantId   String?
  dishVariantName String?
  dishName        String
  dishPrice       Float
  qty             Int             @default(1)
  // Per-line discount, 0-100. Null on every line taken before this existed and
  // on every undiscounted line since — read that as "no discount". Applied by a
  // waiter at the till against a supervisor PIN, and printed on the bill so the
  // guest can see what came off.
  //
  // Money is derived from this in three places (order totals, the journal entry
  // at payment, DishSale.totalSaleAmount) and all three go through
  // calculateLineNetAmount, so a discounted line is worth exactly one thing.
  discountPercent Float?
  totalPrice      Float           @default(0)
  // ── RRA per-line tax ─────────────────────────────────────────────────────
  // Snapshotted at sale time, for the same reason dishName and dishPrice are:
  // reclassifying a dish next month must not rewrite the tax on a receipt
  // already issued and already declared.
  //
  // taxableAmount + taxAmount always equals what the guest was charged for this
  // line after its discount. Null on every line taken outside fiscal mode.
  taxCategory     String?
  taxableAmount   Float?
  taxAmount       Float?
  kitchenStatus   String          @default("new")
  status          String          @default("ACTIVE")
  cancelReason    String?
  notes           String?
  readyAt         DateTime?
  canceledAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  @@index([orderId, status, kitchenStatus])
  @@map("order_items")
}

// A slip that actually went to a station's printer. One row per station per
// fire: an order carrying food and drinks produces a KOT for the kitchen and a
// BOT for the bar, and re-firing after items are added produces another of each.
//
// seq is what the cook reads off the paper. It restarts at 1 every business day,
// per station, so "KOT #6" means the sixth slip that kitchen has seen today.
// The slip prints it padded to four digits (KOT #0006) purely so the numbers
// line up on the rail — the value is a plain integer and a busy day is free to
// run past 9999.
//
// The till assigns seq offline, because a ticket has to print the instant it is
// fired whether or not the internet is up. There is deliberately NO unique
// constraint on it: if a venue ever runs two tills against one station and both
// are offline at once, the two can pick the same number, and a duplicate slip
// number on a report is a far smaller problem than a push that will not sync.
model KitchenTicket {
  id           String          @id @default(cuid())
  restaurantId String
  branchId     String
  branch       Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orderId      String
  order        RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // 'KOT' for a kitchen station, 'BOT' for a bar — taken from Branch.type at
  // the moment it printed, so re-typing a station later cannot rewrite history.
  kind         String
  seq          Int
  // The shift's business day, so a slip fired at 1am belongs to the night that
  // opened it rather than the calendar date it printed on.
  businessDate DateTime
  printedAt    DateTime        @default(now())
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?

  @@index([restaurantId, businessDate])
  @@index([branchId, businessDate, seq])
  @@index([orderId])
  @@map("kitchen_tickets")
}

// A fiscal receipt sequence: gap-free, never repeating, one per receipt type
// per outlet.
//
// Read the note on KitchenTicket.seq above and then read this, because they
// resolve the same conflict in opposite directions ON PURPOSE.
//
// A kitchen slip may repeat its number rather than fail to sync: a duplicate
// slip number confuses one cook for one second, and a push that will not sync
// loses an order. A fiscal receipt is the reverse. A repeated or skipped
// receipt number is exactly what RRA audits for, so here a collision must fail
// loudly and be retried rather than be quietly tolerated.
//
// Which is also why this cannot reuse the order-number generator: that reads
// the newest order and adds one, so deleting an order frees its number for
// reuse, and two offline tills reach the same number independently.
//
// The number is claimed by incrementing nextValue inside the settlement
// transaction and taking the value BEFORE the increment. Under Postgres and
// SQLite alike that is atomic against concurrent claims, so two tills settling
// at the same instant cannot be issued the same receipt number.
model FiscalCounter {
  id           String   @id @default(cuid())
  restaurantId String
  branchId     String
  // NS normal sale · NR refund · CS copy · TS training · PS proforma.
  // Each type carries its own sequence — a refund is not the next sale.
  receiptType  String
  // The next number to hand out. Never decremented, never reset: a counter that
  // restarts each day would repeat last week's numbers within the month.
  nextValue    Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([branchId, receiptType])
  @@index([restaurantId])
  @@map("fiscal_counters")
}

// One row per fiscal receipt issued. The permanent record of what was declared.
//
// Every figure here is STORED as declared, never derived later. That is the
// opposite of the rule used for ordinary orders, where the per-bracket split is
// computed from the lines on demand — and the reason is that these numbers were
// signed. The VSDC's signature covers the amounts we sent it; recomputing them
// next year, after a rounding rule or a tax bracket has moved, could produce a
// figure that no longer matches the signature on the paper in the guest's hand.
// A fiscal record has to say what WAS declared, not what would be declared now.
//
// It is also what the Z and X daily reports read (§18). Those must reconcile
// with the receipts they summarise, which they cannot do if the two are
// computed by different routes.
model FiscalReceipt {
  id           String   @id @default(cuid())
  restaurantId String
  branchId     String
  // Null for a receipt with no order behind it — a training ticket, or a
  // report-only entry.
  orderId      String?

  // NS sale · NR refund · CS copy · TS training · PS proforma.
  receiptType  String
  // The number we claimed and sent to the VSDC.
  invoiceNumber Int
  // The invoice this one reverses. Refunds only (§7.17), and an original may be
  // reversed exactly once — enforced by the unique index below.
  originalInvoiceNumber Int?

  // ── Returned by the VSDC ────────────────────────────────────────────────
  // All nullable: a training or proforma ticket is never signed (§6.3.6), and a
  // queued receipt has not been answered yet.
  sdcId                String?
  sdcDateTime          DateTime?
  receiptNumberForType Int?
  receiptNumberTotal   Int?
  internalData         String?
  receiptSignature     String?

  // ── What was declared ───────────────────────────────────────────────────
  paymentTypeCode    String?
  totalAmount        Float
  totalTaxableAmount Float
  totalTaxAmount     Float
  taxableAmtA        Float @default(0)
  taxableAmtB        Float @default(0)
  taxableAmtC        Float @default(0)
  taxableAmtD        Float @default(0)
  taxAmtA            Float @default(0)
  taxAmtB            Float @default(0)
  taxAmtC            Float @default(0)
  taxAmtD            Float @default(0)
  // §18.1.13 and §18.1.18 — the report needs both, per receipt.
  itemCount          Int   @default(0)
  discountTotal      Float @default(0)

  // ── Transmission ────────────────────────────────────────────────────────
  // PENDING until the VSDC answers, SENT once it has, FAILED when it refused.
  // A receipt may exist as PENDING and still not be printable: §10 forbids
  // printing before the VSDC responds.
  status    String    @default("PENDING")
  sentAt    DateTime?
  lastError String?

  // The trading day this belongs to, so a sale at 1am lands on the night that
  // opened rather than the calendar date — the same rule the shift uses.
  businessDate DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // The invoice number is ours and must never repeat within an outlet.
  @@unique([branchId, invoiceNumber])
  // §7.17 — an original may be reversed only once — is enforced in code, inside
  // the settlement transaction, NOT by a unique index here.
  //
  // A unique on (branchId, receiptType, originalInvoiceNumber) looks right and
  // is wrong: a COPY also references the invoice it copies, and §7.18 places no
  // limit on how many copies may be printed. That index would silently cap
  // reprints at one. The rule belongs only to refunds, which needs a partial
  // index, and a partial index cannot be written the same way for SQLite and
  // Postgres — so the check stays in code where it can say what it means.
  @@index([branchId, originalInvoiceNumber])
  @@index([restaurantId, businessDate])
  @@index([branchId, businessDate, receiptType])
  @@index([status])
  @@map("fiscal_receipts")
}

// Money into and out of the till that is not a sale (§7.12).
//
// The opening float a supervisor counts in before service, cash dropped to the
// safe mid-shift, a payout to a supplier at the door. The daily report has to
// state the opening deposit (§18.1.12), and a manager counting the drawer at
// close needs to know what SHOULD be in it.
//
// `amount` is ALWAYS POSITIVE and `kind` carries the direction. Storing a
// withdrawal as a negative number reads fine until someone writes a positive
// one by mistake and it quietly adds money to the till instead of removing it —
// a sign error in a cash figure is silent, and this shape makes it impossible.
//
// Corrections are new rows, never edits. A float counted wrong is fixed by
// adding the difference, so the drawer's history stays readable rather than
// being rewritten.
model CashMovement {
  id           String   @id @default(cuid())
  restaurantId String
  branchId     String
  // The service session this belongs to, where the venue runs shifts.
  shiftId      String?
  businessDate DateTime

  // OPENING_FLOAT · DEPOSIT · WITHDRAWAL
  kind           String
  amount         Float
  reason         String?
  recordedByName String?
  // Taking cash OUT needs a supervisor, the same control a cancellation takes.
  // Null on a float or a deposit, which only ever add.
  approvedByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, businessDate])
  @@index([restaurantId, businessDate])
  @@map("cash_movements")
}

// ─── MENU ──────────────────────────────────────────────────────────────────

model Dish {
  id                  String    @id @default(cuid())
  restaurantId        String
  branchId            String
  branch              Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name                String
  category            String?
  menuType            String?
  sellingPrice        Float
  description         String?
  isActive            Boolean   @default(true)
  // MEP (mise en place): batch-cooked portions ready to serve; sales consume these first
  preparedPortions    Float     @default(0)
  preparedPortionCost Float     @default(0)
  // ── RRA item registration ────────────────────────────────────────────────
  // itemCode is what RRA knows this dish as, and it is PERMANENT once issued —
  // it appears on receipts already handed to guests and in declarations already
  // filed. Renaming the dish must never change it. That is why it is stored
  // rather than derived from the name, which is otherwise this row's identity.
  //
  // Not marked unique yet: dishes are keyed per branch, so the same drink sold
  // at two stations is two rows today, and whether those share one code or take
  // two is an open decision. Add the constraint once that is settled — adding
  // it later is a migration; removing a wrong one is a data cleanup.
  itemCode              String?
  // RRA's classification for what this item IS, from their published code list.
  rraClassificationCode String?
  // Tax bracket: A exempt, B standard 18%, C zero-rated, D special. Null falls
  // back to the standard rate at calculation time rather than to exempt —
  // under-declaring is the expensive direction to be wrong in.
  taxCategory           String?
  unitOfMeasure         String?
  packagingUnit         String?
  // GOODS or SERVICE, and it decides whether a sale can be blocked for stock.
  //
  // §7.30: a certified system may not issue a receipt for GOODS when the
  // corresponding stock is short — "However, CIS can issue a receipt for
  // service item regardless the stock."
  //
  // Defaults to SERVICE because that is what a restaurant mostly sells: a plate
  // of food is prepared to order, and its ingredients are tracked, not the
  // plate itself. A manager marks the genuine goods — bottled drinks, packaged
  // items bought and resold as they are.
  //
  // This default is also what keeps the 211 Sirocco dishes with no recipe from
  // blocking service on day one. It is a real distinction, not a loophole: the
  // exemption exists in the clause precisely because prepared food cannot be
  // counted the way a bottle can.
  itemType              String    @default("SERVICE")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  ingredients DishIngredient[]
  variants    DishVariant[]
  orderItems  OrderItem[]
  dishSales   DishSale[]

  @@unique([restaurantId, branchId, name])
  @@index([branchId, isActive])
  @@map("dishes")
}

model DishVariant {
  id           String    @id @default(cuid())
  dishId       String
  dish         Dish      @relation(fields: [dishId], references: [id], onDelete: Cascade)
  name         String
  sellingPrice Float
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@unique([dishId, name])
  @@index([dishId, sortOrder, isActive])
  @@map("dish_variants")
}

// Dish recipe: how much of each inventory item one serving uses.
model DishIngredient {
  id               String        @id @default(cuid())
  dishId           String
  dish             Dish          @relation(fields: [dishId], references: [id], onDelete: Cascade)
  inventoryItemId  String
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  quantityRequired Float
  unit             String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([dishId, inventoryItemId])
  @@map("dish_ingredients")
}

// ─── INVENTORY ─────────────────────────────────────────────────────────────

model InventoryItem {
  id           String    @id @default(cuid())
  restaurantId String
  branchId     String
  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name         String
  unit         String
  unitCost     Float     @default(0)
  quantity     Float     @default(0)
  reorderLevel Float     @default(0)
  category     String?
  description  String?
  type         String    @default("purchased")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  dishIngredients   DishIngredient[]
  saleIngredients   DishSaleIngredient[]
  purchases         InventoryPurchase[]
  wasteLogs         WasteLog[]
  adjustmentLogs    InventoryAdjustmentLog[]
  batchUsageLedgers InventoryBatchUsageLedger[]
  stockTakes        StockTake[]
  prepIngredients   PrepIngredient[]            @relation("PrepItemIngredients")
  usedInPreps       PrepIngredient[]            @relation("IngredientUsedInPreps")

  @@unique([restaurantId, branchId, name])
  @@index([branchId])
  @@map("inventory_items")
}

// Sub-recipe for a prep: raw purchased items consumed to produce one unit of the prep.
model PrepIngredient {
  id               String        @id @default(cuid())
  prepItemId       String
  prepItem         InventoryItem @relation("PrepItemIngredients", fields: [prepItemId], references: [id], onDelete: Cascade)
  ingredientItemId String
  ingredient       InventoryItem @relation("IngredientUsedInPreps", fields: [ingredientItemId], references: [id], onDelete: Cascade)
  quantityRequired Float
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([prepItemId, ingredientItemId])
  @@index([prepItemId])
  @@map("prep_ingredients")
}

// A user-made tab for grouping stock on the inventory screen. Purely a lens:
// an item's category never affects costing, consumption or reporting, and an
// item with none simply lives under "All" like everything else.
//
// The tab list is the union of these rows and whatever category names items
// already carry, so categories typed before this table existed keep working
// while a freshly created, still-empty tab survives a reload.
model InventoryCategory {
  id           String    @id @default(cuid())
  restaurantId String
  name         String
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("inventory_categories")
}

model InventoryPurchase {
  id                   String        @id @default(cuid())
  restaurantId         String
  branchId             String
  branch               Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ingredientId         String
  ingredient           InventoryItem @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  batchId              String?
  supplier             String?
  purchaseQuantity     Float?
  purchaseUnit         String?
  unitsPerPurchaseUnit Float?
  purchaseUnitCost     Float?
  quantityPurchased    Float
  remainingQuantity    Float
  unitCost             Float
  totalCost            Float
  paymentMethod        String        @default("Cash")
  paidAt               DateTime?
  purchasedAt          DateTime      @default(now())
  // Optional: most stock is recorded without one, so null means "no expiry
  // tracked" and must never be read as "expires today".
  expiresAt            DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?

  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  batchUsageLedgers InventoryBatchUsageLedger[]

  @@index([branchId])
  @@index([restaurantId])
  @@map("inventory_purchases")
}

model InventoryAdjustmentLog {
  id                 String        @id @default(cuid())
  restaurantId       String
  branchId           String
  branch             Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ingredientId       String
  ingredient         InventoryItem @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  adjustmentType     String
  quantityDelta      Float
  itemQuantityBefore Float
  itemQuantityAfter  Float
  reason             String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([branchId, ingredientId, createdAt])
  @@map("inventory_adjustment_logs")
}

// FIFO batch tracking: each purchase is a batch; usage is tracked per batch.
model InventoryBatchUsageLedger {
  id               String            @id @default(cuid())
  restaurantId     String
  branchId         String
  purchaseId       String
  purchase         InventoryPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  ingredientId     String
  ingredient       InventoryItem     @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  sourceType       String
  sourceId         String
  batchId          String
  quantityConsumed Float
  unitCost         Float
  totalCost        Float
  reason           String?
  consumedAt       DateTime          @default(now())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([branchId])
  @@index([purchaseId])
  @@index([sourceType, sourceId])
  @@map("inventory_batch_usage_ledgers")
}

// ─── MEP (MISE EN PLACE) ───────────────────────────────────────────────────

// Persistent per-station (branch) MEP list. Staff add prep items or dishes from
// the catalog; the row stays until removed (soft delete). targetId is a soft
// reference: InventoryItem.id when targetType='prep', Dish.id when 'dish'.
model MepListItem {
  id           String    @id @default(cuid())
  restaurantId String
  branchId     String
  targetType   String // 'prep' | 'dish'
  targetId     String
  addedBy      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@unique([branchId, targetType, targetId])
  @@index([restaurantId, branchId])
  @@map("mep_list_items")
}

// One "qty prepared" log. Producing a prep creates a kitchen-made
// InventoryPurchase layer (producedPurchaseId anchors undo); producing a dish
// increments Dish.preparedPortions. clientLogId makes offline pushes idempotent.
model PrepLog {
  id                 String    @id @default(cuid())
  restaurantId       String
  branchId           String
  targetType         String // 'prep' | 'dish'
  targetId           String
  quantity           Float
  unit               String?
  totalCost          Float     @default(0)
  costPerUnit        Float     @default(0)
  producedPurchaseId String?
  madeBy             String?
  madeAt             DateTime  @default(now())
  clientLogId        String?   @unique
  reversedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([restaurantId, branchId, madeAt])
  @@map("prep_logs")
}

// ─── DISH SALES & COGS ─────────────────────────────────────────────────────

// Created automatically when an order is marked PAID.
// One DishSale per dish in the order, capturing COGS for that dish.
model DishSale {
  id                 String           @id @default(cuid())
  restaurantId       String
  branchId           String
  branch             Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orderId            String?
  order              RestaurantOrder? @relation(fields: [orderId], references: [id])
  orderItemId        String?
  dishId             String
  dish               Dish             @relation(fields: [dishId], references: [id], onDelete: Cascade)
  dishVariantId      String?
  dishVariantName    String?
  dishName           String
  quantitySold       Float
  totalSaleAmount    Float
  calculatedFoodCost Float            @default(0)
  paymentMethod      String           @default("Cash")
  saleDate           DateTime         @default(now())
  // Business day (from the order's shift) this sale is attributed to; null for
  // sales with no shift, which fall back to saleDate in reports.
  businessDate       DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  saleIngredients DishSaleIngredient[]

  @@index([restaurantId, branchId])
  @@index([orderId])
  @@index([orderItemId])
  @@map("dish_sales")
}

// Which inventory batches were consumed to fulfil this dish sale.
model DishSaleIngredient {
  id           String        @id @default(cuid())
  dishSaleId   String
  dishSale     DishSale      @relation(fields: [dishSaleId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   InventoryItem @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantityUsed Float
  actualCost   Float
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("dish_sale_ingredients")
}

model WasteLog {
  id             String        @id @default(cuid())
  restaurantId   String
  branchId       String
  branch         Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ingredientId   String
  ingredient     InventoryItem @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantityWasted Float
  reason         String
  calculatedCost Float         @default(0)
  notes          String?
  date           DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  @@index([branchId])
  @@map("waste_logs")
}

model StockTake {
  id           String        @id @default(cuid())
  restaurantId String
  branchId     String
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   InventoryItem @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity     Float
  takenAt      DateTime      @default(now())
  notes        String?
  recordedBy   String?
  createdAt    DateTime      @default(now())

  @@index([branchId])
  @@index([ingredientId, takenAt])
  @@map("stock_takes")
}

// ─── ACCOUNTING ────────────────────────────────────────────────────────────

// Account type groupings (asset, liability, equity, revenue, expense).
model Category {
  id           String      @id @default(cuid())
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  type         String
  description  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  accounts Account[]

  @@unique([restaurantId, name])
  @@map("categories")
}

// Chart of accounts. Seed with standard accounts on restaurant creation.
model Account {
  id           String      @id @default(cuid())
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category    @relation(fields: [categoryId], references: [id])
  code         String
  name         String
  type         String
  description  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  journalLines JournalLine[]

  @@unique([restaurantId, code])
  @@map("accounts")
}

// Double-entry header: one entry per transaction event (order paid, purchase, etc.)
model JournalEntry {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId     String?
  description  String?
  reference    String?
  entryDate    DateTime   @default(now())
  // Business day (from the paying order's shift) this entry is attributed to;
  // null for manual/non-order entries, which fall back to entryDate in reports.
  businessDate DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  lines     JournalLine[]
  orders    RestaurantOrder[]
  purchases InventoryPurchase[]

  @@index([restaurantId, entryDate])
  @@index([branchId])
  @@map("journal_entries")
}

// Debit or credit line on a journal entry.
model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Float        @default(0)
  credit         Float        @default(0)
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([journalEntryId])
  @@map("journal_lines")
}

// ─── SYNC ──────────────────────────────────────────────────────────────────

model BranchDevice {
  id            String     @id @default(cuid())
  deviceId      String     @unique
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId      String?
  appVersion    String
  schemaVersion Int
  lastSeenAt    DateTime   @default(now())
  status        String     @default("active")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([restaurantId, lastSeenAt])
  @@map("branch_devices")
}

// Tracks the high-water mark for each device/entity sync channel.
model SyncCursor {
  id           String    @id @default(cuid())
  scopeId      String
  target       String
  restaurantId String?
  branchId     String?
  branch       Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  lastPulledAt DateTime?
  lastPushedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([scopeId, target])
  @@index([branchId])
  @@map("sync_cursors")
}

// Outgoing changes queued to be delivered to devices on next pull.
model SyncOutbox {
  id             String    @id @default(cuid())
  scopeId        String
  restaurantId   String?
  branchId       String?
  branch         Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  entityType     String
  entityId       String
  operation      String
  payload        String
  mutationId     String
  sourceDeviceId String?
  attempts       Int       @default(0)
  availableAt    DateTime?
  claimedAt      DateTime?
  syncedAt       DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([scopeId, mutationId])
  @@index([branchId, syncedAt, createdAt])
  @@map("sync_outbox")
}

model SyncConflictLog {
  id            String   @id @default(cuid())
  scopeId       String
  restaurantId  String?
  branchId      String?
  entityType    String
  entityId      String
  reason        String
  localPayload  String?
  remotePayload String?
  createdAt     DateTime @default(now())

  @@index([branchId])
  @@index([scopeId, entityType, entityId, createdAt])
  @@map("sync_conflict_logs")
}

// Tracks schema version on server-side DB for Electron migration gating.
model AppSchemaState {
  key            String    @id
  databaseKind   String
  schemaVersion  Int
  lastMigratedAt DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("app_schema_state")
}

// ─── ACCOUNTS RECEIVABLE / PAYABLE ─────────────────────────────────────────

model CreditSale {
  id            String     @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId      String?
  customerName  String
  customerPhone String?
  description   String
  amount        Float
  saleDate      DateTime
  paidAt        DateTime?
  paymentMethod String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([restaurantId, paidAt])
  @@index([restaurantId, customerName])
  @@map("credit_sales")
}

model SupplierDebt {
  id            String     @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId      String?
  supplierName  String
  supplierPhone String?
  description   String
  amount        Float
  purchaseDate  DateTime
  paidAt        DateTime?
  paymentMethod String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([restaurantId, paidAt])
  @@index([restaurantId, supplierName])
  @@map("supplier_debts")
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  images    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("chat_messages")
}
