generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String              @id @default(cuid())
  email                   String              @unique
  name                    String?
  password                String
  role                    String              @default("admin")
  businessType            String?             @default("general")
  trackingMode            String              @default("simple")
  fifoEnabled             Boolean             @default(false)
  isActive                Boolean             @default(true)
  isSuperAdmin            Boolean             @default(false)
  subscriptionPlan        String?
  subscriptionExpiry      DateTime?
  logoUrl                 String?
  recoveryKeyHash         String?
  restaurantId            String?
  branchId                String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  subscriptionActivatedAt DateTime?
  dailySummaries          DailySummary[]
  dishSales               DishSale[]
  dishes                  Dish[]
  employees               Employee[]
  inventoryItems          InventoryItem[]
  inventoryPurchases      InventoryPurchase[]
  inventoryAdjustmentLogs InventoryAdjustmentLog[]
  pendingOrders           PendingOrder[]
  ownedRestaurants        Restaurant[]        @relation("RestaurantOwner")
  transactions            Transaction[]
  uploads                 Upload[]
  restaurant              Restaurant?         @relation("RestaurantWaiters", fields: [restaurantId], references: [id])
  wasteLogs               WasteLog[]

  @@map("users")
}

model Restaurant {
  id               String                @id @default(cuid())
  name             String
  ownerId          String
  joinCode         String                @unique
  syncRestaurantId String?               @unique
  syncToken        String?
  billHeader       String?               @default("")
  qrOrderingMode   String                @default("order")
  trialStartAt     DateTime              @default(now())
  licenseExpiry    DateTime?
  licenseActive    Boolean               @default(true)
  fifoEnabled      Boolean               @default(false)
  fifoConfiguredAt DateTime?
  fifoCutoverAt    DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  accounts         Account[]
  categories       Category[]
  dailySummaries   DailySummary[]
  pendingOrders    PendingOrder[]
  orders           RestaurantOrder[]
  syncBatches      RestaurantSyncBatch[]
  syncEvents       RestaurantSyncEvent[]
  syncState        RestaurantSyncState?
  tables           RestaurantTable[]
  owner            User                  @relation("RestaurantOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  transactions     Transaction[]
  waiters          User[]                @relation("RestaurantWaiters")
  inventoryAdjustmentLogs InventoryAdjustmentLog[]
  branches        RestaurantBranch[]
  branchDevices   BranchDevice[]
  syncOutbox      SyncOutbox[]
  syncCursors     SyncCursor[]
  syncConflicts   SyncConflictLog[]

  @@index([ownerId])
  @@map("restaurants")
}

model RestaurantBranch {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  code         String
  isMain       Boolean    @default(false)
  isActive     Boolean    @default(true)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, code])
  @@map("restaurant_branches")
}

model RestaurantTable {
  id            String            @id @default(cuid())
  restaurantId  String
  name          String
  seats         Int               @default(4)
  status        String            @default("available")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  branchId      String            // NOT NULL — enforced by migration 20260429000002
  pendingOrders PendingOrder[]
  orders        RestaurantOrder[]
  restaurant    Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, branchId])
  @@map("restaurant_tables")
}

model RestaurantOrder {
  id                                 String                @id @default(cuid())
  restaurantId                       String
  tableId                            String?
  tableName                          String
  orderNumber                        String
  status                             String                @default("PENDING")
  paymentMethod                      String?
  subtotalAmount                     Float                 @default(0)
  vatAmount                          Float                 @default(0)
  totalAmount                        Float                 @default(0)
  createdById                        String
  createdByName                      String
  servedById                         String?
  servedByName                       String?
  paidById                           String?
  paidByName                         String?
  canceledById                       String?
  canceledByName                     String?
  cancellationApprovedByEmployeeId   String?
  cancellationApprovedByEmployeeName String?
  cancellationApprovedAt             DateTime?
  cancelReason                       String?
  createdAt                          DateTime              @default(now())
  servedAt                           DateTime?
  paidAt                             DateTime?
  canceledAt                         DateTime?
  updatedAt                          DateTime              @updatedAt
  branchId                           String?
  items                              RestaurantOrderItem[]
  table                              RestaurantTable?      @relation(fields: [tableId], references: [id])
  restaurant                         Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId, status, createdAt])
  @@map("restaurant_orders")
}

model RestaurantOrderItem {
  id                                 String          @id @default(cuid())
  orderId                            String
  dishId                             String
  dishName                           String
  dishPrice                          Float
  qty                                Int             @default(1)
  kitchenStatus                      String          @default("new")
  status                             String          @default("ACTIVE")
  canceledById                       String?
  canceledByName                     String?
  cancellationApprovedByEmployeeId   String?
  cancellationApprovedByEmployeeName String?
  cancelReason                       String?
  wastedById                         String?
  wastedByName                       String?
  wasteReason                        String?
  wasteAcknowledged                  Boolean         @default(false)
  readyAt                            DateTime?
  canceledAt                         DateTime?
  wastedAt                           DateTime?
  createdAt                          DateTime        @default(now())
  updatedAt                          DateTime        @updatedAt
  order                              RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status, kitchenStatus])
  @@map("restaurant_order_items")
}

model PendingOrder {
  id           String           @id @default(cuid())
  restaurantId String
  tableId      String?
  tableName    String
  dishId       String
  dishName     String
  dishPrice    Float
  qty          Int              @default(1)
  status       String           @default("new")
  notes        String?
  waiterId     String
  addedAt      DateTime         @default(now())
  readyAt      DateTime?
  branchId     String?
  waiter       User             @relation(fields: [waiterId], references: [id], onDelete: Cascade)
  table        RestaurantTable? @relation(fields: [tableId], references: [id])
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("pending_orders")
}

model RestaurantAction {
  id           String   @id @default(cuid())
  restaurantId String
  userId       String
  actionKey    String
  actionType   String
  orderId      String?
  orderItemId  String?
  tableId      String?
  tableName    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  branchId     String?

  @@unique([restaurantId, actionKey])
  @@index([restaurantId, actionType, createdAt])
  @@map("restaurant_actions")
}

model RestaurantSyncState {
  restaurantId           String     @id
  lastAttemptAt          DateTime?
  lastSuccessAt          DateTime?
  lastErrorAt            DateTime?
  lastErrorMessage       String?
  consecutiveFailures    Int        @default(0)
  lastSyncedTransactions Int        @default(0)
  lastSyncedSummaries    Int        @default(0)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  restaurant             Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_sync_states")
}

model RestaurantSyncEvent {
  id                  String     @id @default(cuid())
  restaurantId        String
  status              String
  message             String
  syncedTransactions  Int        @default(0)
  syncedSummaries     Int        @default(0)
  consecutiveFailures Int        @default(0)
  createdAt           DateTime   @default(now())
  restaurant          Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
  @@map("restaurant_sync_events")
}

model RestaurantSyncBatch {
  id                 String     @id @default(cuid())
  restaurantId       String
  batchId            String
  payloadHash        String
  status             String
  errorMessage       String?
  syncedTransactions Int        @default(0)
  syncedSummaries    Int        @default(0)
  receivedAt         DateTime   @default(now())
  appliedAt          DateTime?
  updatedAt          DateTime   @updatedAt
  restaurant         Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, batchId])
  @@index([restaurantId, receivedAt])
  @@map("restaurant_sync_batches")
}

model Upload {
  id             String        @id @default(cuid())
  userId         String
  fileName       String
  filePath       String
  status         String        @default("pending")
  rawText        String?
  translatedText String?
  pendingData    String?
  errorMessage   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  transactions   Transaction[]
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("uploads")
}

model Category {
  id           String        @id @default(cuid())
  restaurantId String?
  name         String
  type         String
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  accounts     Account[]
  restaurant   Restaurant?   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([restaurantId, name])
  @@map("categories")
}

model Account {
  id           String        @id @default(cuid())
  restaurantId String?
  code         String
  name         String
  categoryId   String
  type         String
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  category     Category      @relation(fields: [categoryId], references: [id])
  restaurant   Restaurant?   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([restaurantId, code])
  @@map("accounts")
}

model Transaction {
  id                      String      @id @default(cuid())
  userId                  String
  restaurantId            String?
  uploadId                String?
  accountId               String
  categoryId              String
  date                    DateTime
  description             String
  amount                  Float
  type                    String
  isManual                Boolean     @default(false)
  paymentMethod           String      @default("Cash")
  pairId                  String?
  accountName             String?
  profitAmount            Float?
  costAmount              Float?
  synced                  Boolean     @default(false)
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  sourceKind              String      @default("manual")
  authoritativeForRevenue Boolean     @default(false)
  branchId                String?
  category                Category    @relation(fields: [categoryId], references: [id])
  account                 Account     @relation(fields: [accountId], references: [id])
  upload                  Upload?     @relation(fields: [uploadId], references: [id])
  user                    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant              Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model DailySummary {
  id            String      @id @default(cuid())
  userId        String
  restaurantId  String?
  date          DateTime
  totalRevenue  Float       @default(0)
  totalExpenses Float       @default(0)
  profitLoss    Float       @default(0)
  lastUpdated   DateTime    @updatedAt
  synced        Boolean     @default(false)
  createdAt     DateTime    @default(now())
  branchId      String?
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant    Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // branchId included: same user/restaurant can have one summary per branch per date
  @@unique([userId, restaurantId, branchId, date])
  @@map("daily_summaries")
}

model CustomDictionary {
  id              String   @id @default(cuid())
  kinyarwandaWord String
  englishMeaning  String
  context         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("custom_dictionary")
}

model UnknownWord {
  id              String   @id @default(cuid())
  uploadId        String?
  word            String
  context         String?
  aiQuestion      String?
  userExplanation String?
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([uploadId, word])
  @@map("unknown_words")
}

model FinancialStatement {
  id          String   @id @default(cuid())
  type        String
  periodStart DateTime
  periodEnd   DateTime
  data        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("financial_statements")
}

model Goal {
  id           String   @id @default(cuid())
  userId       String
  type         String
  period       String
  targetAmount Float
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, type, period])
  @@map("goals")
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  images    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@map("chat_messages")
}

model InventoryItem {
  id              String               @id @default(cuid())
  userId          String
  name            String
  description     String?
  unit            String
  unitCost        Float?
  unitPrice       Float?
  quantity        Float                @default(0)
  category        String?
  inventoryType   String               @default("resale")
  reorderLevel    Float                @default(0)
  shelfLifeDays   Int?
  lastRestockedAt DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  restaurantId    String?
  branchId        String?
  purchaseUnit    String?
  unitsPerPurchaseUnit Float?
  dishIngredients DishIngredient[]
  saleIngredients DishSaleIngredient[]
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchases       InventoryPurchase[]
  adjustmentLogs  InventoryAdjustmentLog[]
  wasteLogs       WasteLog[]

  @@unique([userId, name])
  @@index([restaurantId])
  @@map("inventory_items")
}

model Dish {
  id           String           @id @default(cuid())
  userId       String
  name         String
  sellingPrice Float
  category     String?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  restaurantId String?
  branchId     String           // NOT NULL — enforced by migration 20260429000002
  ingredients  DishIngredient[]
  sales        DishSale[]
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([restaurantId, branchId, isActive])
  @@map("dishes")
}

model DishIngredient {
  id               String        @id @default(cuid())
  dishId           String
  ingredientId     String
  quantityRequired Float
  ingredient       InventoryItem @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  dish             Dish          @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@unique([dishId, ingredientId])
  @@map("dish_ingredients")
}

model DishSale {
  id                 String               @id @default(cuid())
  userId             String
  dishId             String
  quantitySold       Float
  saleDate           DateTime             @default(now())
  paymentMethod      String               @default("Cash")
  totalSaleAmount    Float
  calculatedFoodCost Float                @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  restaurantId       String?
  orderId            String?
  branchId           String?
  saleIngredients    DishSaleIngredient[]
  dish               Dish                 @relation(fields: [dishId], references: [id], onDelete: Cascade)
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([orderId])
  @@map("dish_sales")
}

model WasteLog {
  id             String        @id @default(cuid())
  userId         String
  ingredientId   String
  quantityWasted Float
  reason         String
  date           DateTime      @default(now())
  calculatedCost Float         @default(0)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  restaurantId   String?
  branchId       String?
  ingredient     InventoryItem @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("waste_logs")
}

model InventoryPurchase {
  id                   String        @id @default(cuid())
  userId               String
  ingredientId         String
  supplier             String?
  quantityPurchased    Float
  remainingQuantity    Float
  unitCost             Float
  totalCost            Float
  purchasedAt          DateTime      @default(now())
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  restaurantId         String?
  branchId             String?
  batchId              String?
  journalPairId        String?
  purchaseQuantity     Float?
  purchaseUnit         String?
  unitsPerPurchaseUnit Float?
  purchaseUnitCost     Float?
  ingredient           InventoryItem @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("inventory_purchases")
}

model InventoryAdjustmentLog {
  id                 String        @id @default(cuid())
  userId             String
  restaurantId       String?
  branchId           String?
  ingredientId       String
  adjustmentType     String
  quantityDelta      Float
  itemQuantityBefore Float
  itemQuantityAfter  Float
  batchId            String?
  reason             String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant         Restaurant?   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  ingredient         InventoryItem @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([restaurantId, ingredientId, createdAt])
  @@index([restaurantId, batchId])
  @@map("inventory_adjustment_logs")
}

model DishSaleIngredient {
  id           String        @id @default(cuid())
  dishSaleId   String
  ingredientId String
  quantityUsed Float
  actualCost   Float
  ingredient   InventoryItem @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  dishSale     DishSale      @relation(fields: [dishSaleId], references: [id], onDelete: Cascade)

  @@map("dish_sale_ingredients")
}

model Employee {
  id                          String   @id @default(cuid())
  userId                      String
  name                        String
  role                        String
  payType                     String
  payRate                     Float
  isActive                    Boolean  @default(true)
  canApproveOrderCancellation Boolean  @default(false)
  cancellationPinHash         String?
  phone                       String?
  restaurantId                String?
  branchId                    String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  user                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shifts                      Shift[]

  @@map("employees")
}

model Shift {
  id             String   @id @default(cuid())
  employeeId     String
  userId         String
  date           DateTime
  hoursWorked    Float
  calculatedWage Float
  notes          String?
  createdAt      DateTime @default(now())
  restaurantId   String?
  branchId       String?
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("shifts")
}

model PricingPlan {
  id            String   @id @default(cuid())
  name          String
  duration      Int
  price         Float
  currency      String   @default("GHS")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  seedKey       String?  @unique
  systemManaged Boolean  @default(false)

  @@map("pricing_plans")
}

model AppSchemaState {
  key                 String    @id
  databaseKind        String
  schemaVersion       Int
  syncProtocolVersion Int
  bootstrapVersion    Int
  migrationState      String
  lastMigratedAt      DateTime?
  lastBootstrapAt     DateTime?
  lastError           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("app_schema_state")
}

model BranchDevice {
  id            String     @id @default(cuid())
  deviceId      String     @unique
  restaurantId  String?
  appVersion    String
  schemaVersion Int
  lastSeenAt    DateTime   @default(now())
  status        String     @default("active")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  branchId      String?
  restaurant    Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, lastSeenAt])
  @@map("branch_devices")
}

model SyncOutbox {
  id             String    @id @default(cuid())
  scopeId        String
  restaurantId   String?
  entityType     String
  entityId       String
  operation      String
  payload        String
  mutationId     String
  sourceDeviceId String?
  attempts       Int       @default(0)
  availableAt    DateTime?
  claimedAt      DateTime?
  syncedAt       DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  branchId       String?
  restaurant     Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([scopeId, mutationId])
  @@index([scopeId, syncedAt, createdAt])
  @@index([scopeId, entityType, entityId, createdAt])
  @@map("sync_outbox")
}

model SyncCursor {
  id             String    @id @default(cuid())
  scopeId        String
  target         String
  restaurantId   String?
  lastPulledAt   DateTime?
  lastPushedAt   DateTime?
  lastMutationId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  restaurant     Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([scopeId, target])
  @@index([restaurantId, updatedAt])
  @@map("sync_cursors")
}

model SyncConflictLog {
  id               String    @id @default(cuid())
  scopeId          String
  restaurantId     String?
  entityType       String
  entityId         String
  reason           String
  localMutationId  String?
  remoteMutationId String?
  localPayload     String?
  remotePayload    String?
  createdAt        DateTime  @default(now())
  branchId         String?
  restaurant       Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([scopeId, createdAt])
  @@index([restaurantId, entityType, entityId, createdAt])
  @@map("sync_conflict_logs")
}

model InventoryBatchUsageLedger {
  id               String        @id @default(cuid())
  userId           String
  restaurantId     String?
  purchaseId       String
  ingredientId     String
  sourceType       String
  sourceId         String
  batchId          String
  quantityConsumed Float
  unitCost         Float
  totalCost        Float
  reason           String?
  consumedAt       DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  branchId         String?

  @@index([restaurantId, ingredientId, consumedAt])
  @@index([restaurantId, batchId])
  @@map("inventory_batch_usage_ledgers")
}
